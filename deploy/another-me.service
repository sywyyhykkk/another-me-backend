[Unit]
Description=Another Me NestJS API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/another-me
ExecStart=/usr/local/bin/node --env-file=/opt/another-me/.env /opt/another-me/dist/main.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
